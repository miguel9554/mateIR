FROM mate-slang:latest AS mate-slang

FROM verilator/verilator:v5.046

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    && rm -rf /var/lib/apt/lists/*

COPY --from=mate-slang /opt/slang /opt/slang
COPY --from=mate-slang /usr/local/include/fmt /usr/local/include/fmt
COPY --from=mate-slang /usr/local/lib/cmake/fmt /usr/local/lib/cmake/fmt
COPY --from=mate-slang /usr/local/lib/libfmt* /usr/local/lib/
RUN echo '/usr/local/lib' > /etc/ld.so.conf.d/local.conf && ldconfig

# Verilator comes from the official prebuilt image. `/opt/slang` and `fmt`
# are copied from the repo's slang base image so the project toolchain stays
# compatible with the existing host and container builds.
ENTRYPOINT []
