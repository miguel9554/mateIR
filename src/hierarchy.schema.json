{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MateIR Hierarchy",
  "description": "Design hierarchy and final clock/reset domain registries produced by mate.",
  "type": "object",
  "required": ["clock_domains", "reset_domains", "top"],
  "properties": {
    "clock_domains": {
      "type": "array",
      "items": { "$ref": "#/$defs/clock_domain" }
    },
    "reset_domains": {
      "type": "array",
      "items": { "$ref": "#/$defs/reset_domain" }
    },
    "top": { "$ref": "#/$defs/module" }
  },
  "additionalProperties": false,

  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_$.]*$"
    },

    "dimension": {
      "type": "object",
      "required": ["left", "right"],
      "properties": {
        "left": { "type": "integer" },
        "right": { "type": "integer" }
      },
      "additionalProperties": false
    },

    "enum_member": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "value": { "type": "integer" }
      },
      "additionalProperties": false
    },

    "type": {
      "type": "object",
      "required": ["kind", "width", "signed"],
      "properties": {
        "kind": { "type": "string", "enum": ["integer", "enum"] },
        "width": { "type": "integer", "minimum": 1 },
        "signed": { "type": "boolean" },
        "packed_dims": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension" }
        },
        "unpacked_dims": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension" }
        },
        "enum_type": { "type": "string" },
        "enum_members": {
          "type": "array",
          "items": { "$ref": "#/$defs/enum_member" }
        }
      },
      "additionalProperties": false
    },

    "hier_signal_ref": {
      "type": "object",
      "required": ["instance_path", "namespace", "name"],
      "properties": {
        "instance_path": {
          "type": "array",
          "items": { "type": "string" }
        },
        "namespace": {
          "type": "string",
          "enum": ["input", "output", "internal", "flop_q", "flop_d"]
        },
        "name": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },

    "clock_domain": {
      "type": "object",
      "required": ["id", "display_name", "edge", "source"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "display_name": { "type": "string" },
        "edge": { "type": "string", "enum": ["posedge", "negedge"] },
        "source": { "$ref": "#/$defs/hier_signal_ref" }
      },
      "additionalProperties": false
    },

    "reset_domain": {
      "type": "object",
      "required": ["id", "display_name", "active_edge", "source"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "display_name": { "type": "string" },
        "active_edge": { "type": "string", "enum": ["posedge", "negedge"] },
        "source": { "$ref": "#/$defs/hier_signal_ref" }
      },
      "additionalProperties": false
    },

    "sync_type": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["sync", "clock", "reset", "async", "static"] },
        "clock_domain": { "type": "integer", "minimum": 0 },
        "reset_domain": { "type": "integer", "minimum": 0 },
        "reset_domains": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },

    "signal": {
      "type": "object",
      "required": ["name", "type", "sync_kind", "sync_type"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": { "$ref": "#/$defs/type" },
        "sync_kind": { "type": "string", "enum": ["sync", "clock", "reset", "async", "static"] },
        "sync_type": { "$ref": "#/$defs/sync_type" }
      },
      "additionalProperties": false
    },

    "param": {
      "type": "object",
      "required": ["name", "type", "value"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": { "$ref": "#/$defs/type" },
        "value": { "type": "number" }
      },
      "additionalProperties": false
    },

    "flop": {
      "type": "object",
      "required": ["name", "type", "clock_domain", "reset_domains"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": { "$ref": "#/$defs/type" },
        "clock_domain": { "type": "integer", "minimum": 0 },
        "reset_domains": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "reset_value": { "type": "integer" }
      },
      "additionalProperties": false
    },

    "module": {
      "type": "object",
      "required": [
        "name", "instance_name",
        "parameters", "localparams", "inputs", "outputs",
        "signals", "flops", "submodules"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "instance_name": { "type": "string" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/param" }
        },
        "localparams": {
          "type": "array",
          "items": { "$ref": "#/$defs/param" }
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/signal" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/signal" }
        },
        "signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/signal" }
        },
        "flops": {
          "type": "array",
          "items": { "$ref": "#/$defs/flop" }
        },
        "submodules": {
          "type": "array",
          "items": { "$ref": "#/$defs/module" }
        }
      },
      "additionalProperties": false
    }
  }
}
